# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and cookie origin)
FRONTEND_URL=http://localhost:5173

# Database Connections (Supabase PostgreSQL / Local PostgreSQL)
# Pooled connection string (used by app runtime)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection string (used by Prisma migrations)
DIRECT_URL=postgresql://postgres.xxx:xxx@aws-0-xx.pooler.supabase.com:5432/postgres

# JWT Secret for Cookie Session Tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Setup Secret (Optional security token required to register the initial space owner)
INITIAL_SETUP_SECRET=your_initial_setup_passphrase_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=togetherspace

# Media Limits (in bytes)
MAX_IMAGE_FILE_SIZE=20971520
MAX_VIDEO_FILE_SIZE=104857600
