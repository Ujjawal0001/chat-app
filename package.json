{
  "name": "together-space-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TogetherSpace – Private Two-Person Media Sharing Platform Monorepo",
  "scripts": {
    "build": "cd backend && npm install && npx prisma generate",
    "start": "node backend/src/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && npm install && npx prisma generate",
    "start:backend": "npm --prefix backend start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate"
  },
  "keywords": [
    "together-space",
    "private-media",
    "couples-gallery"
  ],
  "author": "",
  "license": "ISC"
}
